{
  "name": "savr-action",
  "description": "GitHub Action that keeps draft releases ready so teams can publish manually from the GitHub Releases UI.",
  "version": "0.0.0-development",
  "author": "Fabian Pahl",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts",
    "local-action": "local-action . src/main.ts .env",
    "prepare": "husky",
    "test": "vitest"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "handlebars": "4.7.10",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@github/local-action": "7.0.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.14.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "package-changed": "3.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
