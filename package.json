{
  "name": "savr-action",
  "description": "GitHub Action that keeps draft releases ready so teams can publish manually from the GitHub Releases UI.",
  "version": "0.0.0-development",
  "author": "Fabian Pahl",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts",
    "check": "pnpm build && pnpm verify",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "local-action": "local-action . src/main.ts .env",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "handlebars": "4.7.10",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@github/local-action": "7.0.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "package-changed": "3.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
